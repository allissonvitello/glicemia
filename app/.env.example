# Copie este arquivo para .env.local e preencha com os dados do seu projeto Supabase
# (Project Settings -> API Keys). A chave é a PÚBLICA ("publishable"/"anon"):
# ela vai dentro do app, e quem protege os dados são as regras de supabase/esquema.sql.
# Nunca use aqui a chave "secret"/"service_role" nem a senha do banco.
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_SUA-CHAVE
